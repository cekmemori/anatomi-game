# Salin file ini menjadi .env lalu sesuaikan.
# .env TIDAK dibaca oleh Vite secara otomatis untuk variabel server,
# jadi jalankan server dengan environment variable berikut (lihat README).

# PIN guru untuk membuka area /teacher dan /host (wajib diganti).
TEACHER_PIN=2025

# Port server (default 3001).
PORT=3001

# (Opsional) aktifkan HTTPS untuk LAN. Isi path ke sertifikat/kunci.
# SSL_CERT=./certs/cert.pem
# SSL_KEY=./certs/key.pem

# (Opsional) Database PostgreSQL di cloud (contoh di server apotiku.id)
# Jika tidak diisi, server otomatis menggunakan berkas JSON lokal (server/data/students.json)
# DATABASE_URL=postgresql://apotiku_user:ptei123.@localhost:5432/anatomi_db

# (Opsional) batasi origin yang boleh terhubung (dipisah koma).
# Kosong = izinkan same-origin + localhost.
# ALLOWED_ORIGINS=https://anatomi.apotiku.id

